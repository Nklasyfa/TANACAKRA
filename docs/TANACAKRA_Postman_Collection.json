	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "POST /api/v1/auth/login (Petani)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"petani_cangkringan\",\n  \"role\": \"PETANI\"\n}"
						},
						"url": {
							"raw": "http://127.0.0.1:8000/api/v1/auth/login",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "POST /api/v1/auth/login (Admin)",
